# Experiment: OS Detection and Service Version Detection
# Using Nmap -O and -sV flags

import subprocess

def run_nmap(target, option):
    command = ["nmap", option, target]

    print("\nExecuting:", " ".join(command))
    print("-" * 50)

    try:
        result = subprocess.run(
            command,
            capture_output=True,
            text=True,
            timeout=300
        )

        print(result.stdout)

        if result.stderr:
            print("Messages:", result.stderr)

        if result.returncode != 0:
            print("Nmap exited with code:", result.returncode)

    except FileNotFoundError:
        print("Error: Nmap is not installed or not in PATH.")
    except subprocess.TimeoutExpired:
        print("Scan timed out.")
    except Exception as error:
        print("Error:", error)

def main():
    target = input("Enter authorized target IP or hostname: ").strip()

    if not target:
        print("Target cannot be empty.")
        return

    while True:
        print("\n===== Nmap Detection Menu =====")
        print("1. Operating System Detection (-O)")
        print("2. Service Version Detection (-sV)")
        print("3. Combined OS and Service Detection")
        print("4. Exit")

        choice = input("Enter your choice: ").strip()

        if choice == "1":
            run_nmap(target, "-O")
        elif choice == "2":
            run_nmap(target, "-sV")
        elif choice == "3":
            command = ["nmap", "-O", "-sV", target]
            print("\nExecuting:", " ".join(command))
            try:
                result = subprocess.run(
                    command,
                    capture_output=True,
                    text=True,
                    timeout=300
                )
                print(result.stdout)
                if result.stderr:
                    print("Messages:", result.stderr)
            except FileNotFoundError:
                print("Error: Nmap is not installed or not in PATH.")
            except subprocess.TimeoutExpired:
                print("Scan timed out.")
        elif choice == "4":
            print("Experiment completed.")
            break
        else:
            print("Invalid choice. Try again.")

if __name__ == "__main__":
    main()
